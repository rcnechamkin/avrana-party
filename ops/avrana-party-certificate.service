[Unit]
Description=Renew Avrana Party browser certificate with DNS-01
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# lego waits for DNS propagation; a hung run must end and show as failed, not sit forever.
TimeoutStartSec=30min
ExecStart=/usr/local/libexec/avrana-party/renew-party-certificate.sh
