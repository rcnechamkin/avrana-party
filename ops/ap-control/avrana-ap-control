#!/usr/bin/env python3
"""avrana-ap-control: the only privileged interface the Wi-Fi lab may use on the Pi (AVR-298).

Installed root-owned at /usr/local/sbin/avrana-ap-control; the sudoers drop-in allows exactly these
argument vectors and nothing else:

    avrana-ap-control show
    avrana-ap-control set-channel <approved channel> [--lab]
    avrana-ap-control restore

It never runs a shell, takes no free-form input, resolves binaries by absolute path, runs with a
cleared environment and logs every call (with the sudo caller) to the journal.

Safety rules enforced here, not left to the caller:
  * only the NetworkManager profile "Avrana Party Internal" is touched;
  * only approved non-DFS 5 GHz channels, and only if the Pi's regulatory domain currently permits
    them (enabled, no radar detection, no "no IR");
  * never while a Party session is active (a channel change drops every client);
  * without --lab, never while any station is associated; with --lab the caller states that the
    associated station is its own test device;
  * the first change saves the original band/channel; `restore` puts exactly that back.
"""
import json, os, re, subprocess, sys, time, urllib.request

try:
    import syslog
except ImportError:  # not on the Pi; only unit tests on other platforms import this file
    syslog = None

PROFILE = "Avrana Party Internal"
IFACE = "wlan0"
APPROVED_CHANNELS = (36, 40, 44, 48, 149, 153, 157, 161)
STATE_DIR = "/var/lib/avrana-party"
SAVED = os.path.join(STATE_DIR, "ap-saved.json")
NMCLI, IW = "/usr/bin/nmcli", "/usr/sbin/iw"
STATUS_URL = "http://127.0.0.1:8191/party/api/status"
CLEAN_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C"}


class Refused(Exception):
    pass


def log(msg):
    line = f"caller={os.environ.get('SUDO_USER', 'unknown')} {msg}"
    if syslog:
        syslog.syslog(syslog.LOG_INFO, line)
    else:
        print(line, file=sys.stderr)


def parse_args(argv):
    """Pure. argv excludes the program name. Returns (command, channel|None, lab). Raises Refused."""
    if argv == ["show"]:
        return "show", None, False
    if argv == ["restore"]:
        return "restore", None, False
    if len(argv) in (2, 3) and argv[0] == "set-channel":
        if not re.fullmatch(r"[1-9][0-9]{1,2}", argv[1]):
            raise Refused(f"channel must be one of {list(APPROVED_CHANNELS)}")
        ch = int(argv[1])
        if ch not in APPROVED_CHANNELS:
            raise Refused(f"channel {ch} is not approved; allowed: {list(APPROVED_CHANNELS)}")
        if len(argv) == 3:
            if argv[2] != "--lab":
                raise Refused("only the optional flag --lab is accepted")
            return "set-channel", ch, True
        return "set-channel", ch, False
    raise Refused("usage: show | set-channel <channel> [--lab] | restore")


def channel_allowed(phy_info, channel):
    """Pure. phy_info is `iw phy phyN info` text. True when the channel is usable for an AP here."""
    for line in phy_info.splitlines():
        m = re.search(r"\*\s*(\d+)(?:\.\d+)? MHz \[(\d+)\](.*)", line)  # iw prints "5180.0 MHz"
        if m and int(m.group(2)) == channel and int(m.group(1)) > 4000:
            rest = m.group(3)
            return not any(x in rest for x in ("disabled", "radar detection", "no IR"))
    return False


def run(cmd, timeout=30):
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=CLEAN_ENV, shell=False)
    return p.returncode, p.stdout, p.stderr.strip()


def profile_state():
    rc, out, err = run([NMCLI, "-t", "-f", "802-11-wireless.band,802-11-wireless.channel,connection.id",
                        "connection", "show", PROFILE])
    if rc != 0:
        raise Refused(f"cannot read profile {PROFILE!r}: {err}")
    kv = dict(line.split(":", 1) for line in out.splitlines() if ":" in line)
    return {"band": kv.get("802-11-wireless.band", ""), "channel": kv.get("802-11-wireless.channel", "")}


def radio_state():
    rc, out, _ = run([IW, "dev", IFACE, "info"])
    m = re.search(r"channel (\d+) \((\d+) MHz\), width: (\d+) MHz", out)
    wiphy = re.search(r"wiphy (\d+)", out)
    return {"channel": int(m.group(1)) if m else None, "freq_mhz": int(m.group(2)) if m else None,
            "width_mhz": int(m.group(3)) if m else None, "phy": f"phy{wiphy.group(1)}" if wiphy else "phy0"}


def stations():
    rc, out, _ = run([IW, "dev", IFACE, "station", "dump"])
    return len(re.findall(r"^Station ", out, re.M)) if rc == 0 else None


def party_session_active():
    """True / False / None (unknown). Fails closed in the caller when unknown and not --lab."""
    try:
        req = urllib.request.Request(STATUS_URL, headers={"Host": "party.avrana.net"})
        with urllib.request.urlopen(req, timeout=3) as r:
            doc = json.load(r)
        return bool((doc.get("party_core") or {}).get("session"))
    except Exception:
        return None


def apply(band, channel):
    rc, _, err = run([NMCLI, "connection", "modify", PROFILE, "802-11-wireless.band", band,
                      "802-11-wireless.channel", str(channel)])
    if rc != 0:
        raise Refused(f"nmcli modify failed: {err}")
    rc, _, err = run([NMCLI, "connection", "up", PROFILE], timeout=60)
    if rc != 0:
        raise Refused(f"nmcli up failed: {err}")


def cmd_show():
    return {"profile": profile_state(), "radio": radio_state(), "stations": stations(),
            "saved_original": json.load(open(SAVED)) if os.path.exists(SAVED) else None,
            "approved_channels": list(APPROVED_CHANNELS)}


def cmd_set(channel, lab):
    if party_session_active() is True:
        raise Refused("a Party session is active: channel changes are forbidden during play")
    n = stations()
    if n is None:
        raise Refused("cannot read the station list")
    if n > 0 and not lab:
        raise Refused(f"{n} station(s) associated; pass --lab only if they are your own test devices")
    if party_session_active() is None and not lab:
        raise Refused("cannot confirm that no Party session is active (status unreachable); use --lab in the lab")
    rs = radio_state()
    rc, info, err = run([IW, "phy", rs["phy"], "info"])
    if rc != 0 or not channel_allowed(info, channel):
        raise Refused(f"channel {channel} is not permitted by the current regulatory domain on this radio")
    os.makedirs(STATE_DIR, exist_ok=True)
    before = profile_state()
    if not os.path.exists(SAVED):
        with open(SAVED, "w") as f:
            json.dump({"saved_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **before}, f)
    try:
        apply("a", channel)
    except Refused:
        # best effort: put the profile back to what it was before this call, then report the failure
        try:
            apply(before["band"] or "a", before["channel"] or 36)
        except Refused as e2:
            log(f"rollback failed: {e2}")
        raise
    return {"changed": {"from": before, "to": {"band": "a", "channel": str(channel)}}}


def cmd_restore():
    if party_session_active() is True:
        raise Refused("a Party session is active: channel changes are forbidden during play")
    if not os.path.exists(SAVED):
        raise Refused("no saved original configuration (nothing was changed through this helper)")
    saved = json.load(open(SAVED))
    band, ch = saved.get("band"), saved.get("channel")
    if band not in ("a", "bg") or not re.fullmatch(r"[0-9]{1,3}", str(ch)):
        raise Refused(f"saved configuration looks invalid: {saved}")
    apply(band, int(ch))
    os.remove(SAVED)
    return {"restored": {"band": band, "channel": ch}}


def main(argv):
    try:
        cmd, ch, lab = parse_args(argv)
        log(f"args={argv}")
        res = {"show": cmd_show, "restore": cmd_restore}.get(cmd, lambda: cmd_set(ch, lab))()
        print(json.dumps({"ok": True, **res}))
        log(f"ok {cmd}")
        return 0
    except Refused as e:
        log(f"refused: {e}")
        print(json.dumps({"ok": False, "error": str(e)}))
        return 2
    except Exception as e:  # never leak a traceback to the caller
        log(f"error: {e!r}")
        print(json.dumps({"ok": False, "error": "internal error, see the journal"}))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
