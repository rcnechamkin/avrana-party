{
  "contract": "avrana.game/v0",
  "id": "checkers",
  "name": "Checkers",
  "summary": "Two sides. Every capture counts.",
  "kind": "native",
  "players": {"min": 2, "max": 2},
  "screen": "no_tv_needed",
  "input": {"model": "browser_native"},
  "late_join": "spectator_only",
  "spectators": "watch",
  "private_player_ui": true,
  "runtime": {"type": "external", "start": "service", "permissions": ["party_roster"]},
  "presentations": [{
    "id": "phone_table", "method": "browser_native", "roles": ["player", "spectator"],
    "requires": {"device": []}, "optional": {"device": ["wake_lock"]}
  }],
  "fallback": "spectate",
  "accessibility": {"timing_pressure": false, "audio_required": false},
  "extensions": {
    "net.avrana.party": {"pregame": false},
    "net.avrana.catalog": {"provider": "native", "category": "Board", "icon": "gamepad", "solo": false}
  }
}
