{
  "contract": "avrana.game/v0",
  "id": "ps1-worms",
  "name": "Worms Armageddon",
  "summary": "One controller, up to four players taking turns.",
  "kind": "emulated",
  "players": {
    "min": 1,
    "max": 4
  },
  "screen": "tv_optional",
  "input": {
    "model": "hotseat",
    "slots": 1
  },
  "late_join": "spectator_only",
  "spectators": "watch",
  "private_player_ui": false,
  "runtime": {
    "type": "emulator_profile",
    "profile": "worms",
    "start": "service",
    "resources": [
      "emulator_slot",
      "hw_encoder"
    ],
    "permissions": [
      "controllers"
    ]
  },
  "presentations": [
    {
      "id": "phone_stream",
      "method": "shared_stream",
      "roles": [
        "player",
        "spectator"
      ],
      "requires": {
        "device": [
          "websocket",
          "webrtc",
          "video.h264"
        ],
        "runtime": [
          "runtime.retroarch",
          "presentation.shared_stream",
          "input.virtual_gamepad"
        ]
      },
      "optional": {
        "device": [
          "wake_lock",
          "web_audio",
          "vibration"
        ]
      }
    },
    {
      "id": "phone_crop",
      "method": "personal_viewport",
      "viewport": "crop",
      "roles": [
        "player",
        "spectator"
      ],
      "requires": {
        "device": [
          "websocket",
          "webrtc",
          "video.h264"
        ],
        "runtime": [
          "runtime.retroarch",
          "presentation.personal_viewport.crop",
          "input.virtual_gamepad"
        ]
      }
    }
  ],
  "fallback": "spectate",
  "accessibility": {
    "timing_pressure": true,
    "text_scalable": false,
    "reduced_motion_respected": false
  },
  "extensions": {
    "net.avrana.catalog": {
      "provider": "retroarch-ps1",
      "status": "experimental",
      "hardwareValidationRequired": true
    },
    "net.avrana.ps1": {
      "serial": "SLUS-00888",
      "stream_slots": 1,
      "multitap": "disabled",
      "metadataSource": {
        "titleProfiles": {
          "ref": "experiment/ps1-title-profiles",
          "commit": "4b8fa60afecb4868be0816f4b908b752bc33296d"
        },
        "manifest": {
          "ref": "experiment/party-service",
          "commit": "59ac8ab7fd8992def20df97042e3cae66686bf9b"
        }
      }
    }
  }
}
