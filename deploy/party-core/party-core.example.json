{
  "hosts": [
    "party.avrana.net"
  ],
  "origins": [
    "https://party.avrana.net"
  ],
  "secure_cookie": true,
  "devices": "/var/lib/avrana-party-core/devices.json",
  "games": {
    "bluff": {
      "min_players": 2,
      "max_players": 6,
      "pregame": true,
      "late_join": "spectator_only",
      "url": "http://127.0.0.1:8096/games/bluff",
      "key_file": "/etc/avrana-party/game-keys/bluff.key"
    },
    "arcade-gauntlet2": {
      "max_players": 2,
      "late_join": "supported",
      "url": "http://127.0.0.1:8098",
      "key_file": "/etc/avrana-party/game-keys/arcade-gauntlet2.key",
      "timeout": 25
    }
  },
  "status": {
    "manifest": "/var/lib/avrana-party/deployment.json",
    "party_checkout": "/home/cody/avrana-party",
    "games_checkout": "/home/cody/avrana-party-games",
    "web_root": "/var/www/avrana-party/web",
    "certificate": "/etc/avrana-party/tls/current/fullchain.pem",
    "games_url": "http://127.0.0.1:8096",
    "arcade_url": "http://127.0.0.1:8098",
    "units": [
      "avrana-party-core",
      "avranaparty-games",
      "avranaparty-arcade",
      "nginx",
      "NetworkManager",
      "avrana-party-certificate.timer"
    ]
  }
}
