# Party Core's game-facing endpoint (ADR 0016 section 4, AVR-258, AVR-236): the Unix socket on
# which a native game reports `ended` and its result. Only members of avrana-games may connect,
# which is every avrana-game@ instance and nothing else; what is said is still verified by the
# reporting game's signature. Party Core inherits it as file descriptor 3
# (avrana.party.service.listen_fds). The public API stays on loopback TCP behind nginx.
#
#   sudo install -m 0644 deploy/party-core/avrana-party-core.socket /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now avrana-party-core.socket
[Unit]
Description=Avrana Party Core internal socket (game -> party)

[Socket]
ListenStream=/run/avrana-party/internal.sock
SocketUser=avrana-party
SocketGroup=avrana-games
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
