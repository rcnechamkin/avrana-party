    # Native games (ADR 0016 section 4, AVR-259): one rule for every title, no per-game block and
    # no port. A native game listens on its own Unix socket, /run/avrana-games/<slug>.sock, which
    # only nginx and Party Core may connect to (group avrana-front). The slug pattern is the Game
    # Contract's id pattern (avrana/contracts/game.py ID): 1 to 40 characters, no "/" and no ".",
    # so no request can name a socket outside that directory. nginx matches locations against the
    # normalised path ("//", "/./", "/../" and %-escapes resolved), so the slug is whatever the
    # path really names; the game is sent the request line as the client wrote it.
    # Source copy: deploy/games/nginx-native-games.location.
    #
    # Control paths are never proxied: Party Core sends launch and end to a game directly, so a
    # request for them through the front door is refused here, for every slug.
    location ~ ^/games/[^/]+/avrana/ {
        return 404;
    }

    # While the LAN Games runtime still serves /games/<slug>/ for its own titles, a slug with no
    # native socket (nginx's own 502 on connect) is answered by it, exactly as before this rule.
    # A 502 a native game returns itself is not intercepted. When that runtime retires
    # (ADR 0014), the error_page line and @lan_games go and nginx answers such a slug itself.
    location ~ "^/games/(?<native_game>[a-z][a-z0-9_-]{0,39})/" {
        proxy_pass http://unix:/run/avrana-games/$native_game.sock:$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        error_page 502 = @lan_games;
    }

    location @lan_games {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
    }

