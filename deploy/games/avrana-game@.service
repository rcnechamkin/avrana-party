# A native game process (ADR 0016 section 5, AVR-236). One template for every title: the
# instance name is the game's slug, and DynamicUser= is its identity, so provisioning creates no
# Unix user. Started by socket activation on the first connection (Party Core's launch, or a
# page request through nginx); never enabled on its own.
#
# What the process is handed (a field-test runtime convention, not an SDK): its listening socket
# as file descriptor 3 (LISTEN_FDS), its own key and no other in $CREDENTIALS_DIRECTORY
# (AVRANA_PARTY_KEYS points there), its state in $STATE_DIRECTORY, and Party Core's internal
# socket in $AVRANA_PARTY_SOCKET (owner decision, AVR-236). A sixth thing, the Party's browser
# origin in $AVRANA_PARTY_ORIGIN (which a game page hands to the bridge shim, ADR 0013, AVR-303),
# is NOT here: it is per appliance, so provision-game writes it into the same drop-in as the
# command, from the `origins` of Party Core's own configuration, and refuses when there is none.
#
# This file carries no ExecStart, by decision: what a given game runs, and from where, is the
# `runtime` object of its appliance grant, which provision-game writes as a root-owned drop-in,
# /etc/systemd/system/avrana-game@<slug>.service.d/exec.conf. Without that drop-in the unit does
# not start, which is the intended failure for a slug nobody provisioned.
# Resource ceilings (MemoryMax, TasksMax, CPUQuota) come from measuring a real game (AVR-238).
[Unit]
Description=Avrana native game (%i)
Requires=avrana-game@%i.socket
After=avrana-game@%i.socket

[Service]
DynamicUser=yes
SupplementaryGroups=avrana-games
StateDirectory=avrana-games/%i
StateDirectoryMode=0700
LoadCredential=%i.key:/etc/avrana-party/game-keys/%i.key
Environment=AVRANA_PARTY_KEYS=%d
Environment=AVRANA_PARTY_SOCKET=/run/avrana-party/internal.sock
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RestrictAddressFamilies=AF_UNIX
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
Restart=on-failure
