# GENERATED by `python3 -m avrana.ops.hosted_site` from avrana-party.nginx. Do not edit: change the
# appliance site (or the renderer) and render again; tests/unit/test_hosted_site.py checks it.
# Hosted staging (docs/design/HOSTED-STAGING.md): the access gateway ends TLS and its tunnel connector
# reaches this site over plain HTTP on 127.0.0.1:8080. Nothing here listens on another address.
# LAN Games runtime routes (BLUFF/EXPO): not rendered.

# Any Host that is not the Party or the game origin: refused, never the Party.
server {
    listen 127.0.0.1:8080 default_server;
    server_name _;
    location / {
        return 404;
    }
}

server {
    listen 127.0.0.1:8080;
    server_name avrana.party;

    # Avrana Full Mode shell: static, Avrana-owned files under /party/, HTTPS only. The port 80
    # server above is unchanged. Installed by ops/install-party-web.sh (a release directory and
    # an atomic "current" symlink; no reload needed per release). Headers must match
    # avrana/web/devserver.py SHELL_HEADERS (tests/unit/test_nginx_site.py). Never send a
    # Service-Worker-Allowed header: the worker must stay inside /party/.
    location = /party {
        return 301 /party/;
    }

    # Lets a page tell "the Pi answered" from "not on the Party Wi-Fi", and which address and TLS
    # version it reached. Never cached, never answered by the service worker.
    location = /party/api/origin.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"schema":"avrana.origin/v0","network":"hosted","scheme":"https","serverAddr":"hosted","tls":"edge","http":"$server_protocol"}';
    }

    # Party Core v0 (AVR-51): the party API, avrana-party-core.service on loopback 127.0.0.1:8191
    # (docs/runbooks/party-core-deploy.md). The exact-match origin.json location above keeps
    # answering from nginx. Source copy: deploy/party-core/nginx-party-api.location.
    # Only /party/api/ is forwarded; the service's /internal/ routes are never proxied (and it
    # refuses anything carrying X-Forwarded-For). Long polls wait up to 25 s.
    location /party/api/ {
        proxy_pass http://127.0.0.1:8191;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 40s;
        proxy_buffering off;
        client_max_body_size 8k;
    }

    # The one Party page a game origin may frame (ADR 0013, BROWSER-ORIGINS 3.2 and 4; AVR-319): the
    # invisible bridge frame a native game page embeds from https://games.avrana.party. The headers are
    # those of /party/ below with frame-ancestors naming the game origin instead of 'none' (an exact
    # match, so no other Party page is frameable by it or by anything else). Party Core does not set
    # this header: it serves no pages. Headers must match avrana/web/devserver.py (the /party/bridge.html
    # route) and tests/unit/test_nginx_site.py. Never send the old frame-options header (it cannot name an origin).
    # CORP same-site + COEP require-corp let a cross-origin isolated game page (COEP require-corp, needed for
    # SharedArrayBuffer and Emscripten threads) embed this frame; same-site, not cross-origin, because the game
    # origin is a sibling (games.avrana.party) and no other site has any business loading this page (AVR-467).
    location = /party/bridge.html {
        alias /var/www/avrana-party/web/current/bridge.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-site" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors https://games.avrana.party" always;
    }

    # The Party layer (AVR-292, ADR 0011 amendment of 2026-10-16): the floating Party button and its
    # drawer, a Party frame that a game page mounts (web/party/bridge/layer-mount.js). A game page is
    # served from this origin today (BLUFF and EXPO) or from https://games.avrana.party, so both may
    # frame it; no other site may. The headers are otherwise those of /party/ below and must match
    # avrana/web/devserver.py (the /party/layer.html route) and tests/unit/test_nginx_site.py.
    location = /party/layer.html {
        alias /var/www/avrana-party/web/current/layer.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https://games.avrana.party" always;
    }

    # The game catalog Party Home reads (AVR-337, EXPERIMENTAL; docs/design/AVRGAME-PACKAGE.md). When
    # root has installed an .avrgame package, ops/install-game writes the EFFECTIVE catalog (the
    # release catalog plus a row per installed package, appended) to the appliance-local file named
    # first below; with no package installed that file does not exist and the release catalog is
    # served, byte for byte, exactly as the /party/ rule below would. Read-only: nginx only reads
    # either file, both are root-owned, and no request can name another. The headers are those of
    # /party/ below. Never a Service-Worker-Allowed header.
    location = /party/catalog.json {
        root /;
        default_type application/json;
        try_files /var/lib/avrana-party/catalog/catalog.json /var/www/avrana-party/web/current/catalog.json =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    }

    location /party/ {
        alias /var/www/avrana-party/web/current/;
        index index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    }

    # Native games (ADR 0016 section 4, AVR-259): one rule for every title, no per-game block and
    # no port. A native game listens on its own Unix socket, /run/avrana-games/<slug>.sock, which
    # only nginx and Party Core may connect to (group avrana-front). The slug pattern is the Game
    # Contract's id pattern (avrana/contracts/game.py ID): 1 to 40 characters, no "/" and no ".",
    # so no request can name a socket outside that directory. nginx matches locations against the
    # normalised path ("//", "/./", "/../" and %-escapes resolved), so the slug is whatever the
    # path really names; the game is sent the request line as the client wrote it. These rules
    # name no title and are the same in every server block that serves native games. Source copy:
    # deploy/games/nginx-native-games.location.
    #
    # Control paths are never proxied: Party Core sends launch and end to a game directly, so a
    # request for them through the front door is refused here, for every slug. The match is on
    # the normalised path and is case-sensitive; a spelling this rule does not match is not a
    # control path to the game either, and a game refuses any control request that carries the
    # proxy headers set below.
    location ~ ^/games/[^/]+/avrana/ {
        return 404;
    }

    # A slug is a native game or nothing. A game that is not provisioned has no socket, and one
    # that is down refuses or closes: either way the phone gets nginx's own 502 and the request
    # is sent nowhere else. nginx reads no registry here; telling "not provisioned" from "down"
    # is left to the game registry (AVR-236).
    location ~ "^/games/(?<native_game>[a-z][a-z0-9_-]{0,39})/" {
        # No game controls a Service Worker in this experimental version (AVR-135). A browser marks
        # the fetch of a worker script it is about to register or update with the request header
        # "Service-Worker: script"; a request that carries that header is refused here, before any
        # game is asked, and a Service-Worker-Allowed header from a game (it would widen a
        # worker's scope) never reaches a phone. This is nginx's to enforce because a package's
        # server is not trusted to refrain. The Party's own worker is served by /party/, not by
        # this rule; a dedicated Worker script is an ordinary request and is served.
        if ($http_service_worker != "") {
            return 403;
        }
        proxy_hide_header Service-Worker-Allowed;
        proxy_pass http://unix:/run/avrana-games/$native_game.sock:$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # The device cookie (ADR 0003, ADR 0013) never goes to a game server: the whole Cookie
        # header is dropped here, which also keeps both cookie names out. AVR-314.
        proxy_set_header Cookie "";
        proxy_read_timeout 3600;
    }

    # Anything else under /games/ names no game (a slug outside the pattern): refused here, never
    # passed to a catch-all. The bare /games is refused the same way.
    location /games/ {
        return 404;
    }
    location = /games {
        return 404;
    }

    # The LAN Games hub is retired as a product surface (ADR 0014; owner decision 2026-10-04): its
    # page is not served, and the root of this origin is Party Home.
    location = / {
        return 302 /party/;
    }
    location ^~ /shared/hub.html {
        return 404;
    }

    # Hosted: no LAN Games runtime and no static root; anything not routed above is 404.
    location / {
        return 404;
    }
}

server {
    listen 127.0.0.1:8080;
    server_name games.avrana.party;

    # The Party and the arcade are not served on this origin. Prefix matches that stop regular
    # expressions: nothing below can answer them.
    location ^~ /party {
        return 404;
    }
    location ^~ /arcade {
        return 404;
    }

    # Native games (ADR 0016 section 4, AVR-259): one rule for every title, no per-game block and
    # no port. A native game listens on its own Unix socket, /run/avrana-games/<slug>.sock, which
    # only nginx and Party Core may connect to (group avrana-front). The slug pattern is the Game
    # Contract's id pattern (avrana/contracts/game.py ID): 1 to 40 characters, no "/" and no ".",
    # so no request can name a socket outside that directory. nginx matches locations against the
    # normalised path ("//", "/./", "/../" and %-escapes resolved), so the slug is whatever the
    # path really names; the game is sent the request line as the client wrote it. These rules
    # name no title and are the same in every server block that serves native games. Source copy:
    # deploy/games/nginx-native-games.location.
    #
    # Control paths are never proxied: Party Core sends launch and end to a game directly, so a
    # request for them through the front door is refused here, for every slug. The match is on
    # the normalised path and is case-sensitive; a spelling this rule does not match is not a
    # control path to the game either, and a game refuses any control request that carries the
    # proxy headers set below.
    location ~ ^/games/[^/]+/avrana/ {
        return 404;
    }

    # A slug is a native game or nothing. A game that is not provisioned has no socket, and one
    # that is down refuses or closes: either way the phone gets nginx's own 502 and the request
    # is sent nowhere else. nginx reads no registry here; telling "not provisioned" from "down"
    # is left to the game registry (AVR-236).
    location ~ "^/games/(?<native_game>[a-z][a-z0-9_-]{0,39})/" {
        # No game controls a Service Worker in this experimental version (AVR-135). A browser marks
        # the fetch of a worker script it is about to register or update with the request header
        # "Service-Worker: script"; a request that carries that header is refused here, before any
        # game is asked, and a Service-Worker-Allowed header from a game (it would widen a
        # worker's scope) never reaches a phone. This is nginx's to enforce because a package's
        # server is not trusted to refrain. The Party's own worker is served by /party/, not by
        # this rule; a dedicated Worker script is an ordinary request and is served.
        if ($http_service_worker != "") {
            return 403;
        }
        proxy_hide_header Service-Worker-Allowed;
        proxy_pass http://unix:/run/avrana-games/$native_game.sock:$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # The device cookie (ADR 0003, ADR 0013) never goes to a game server: the whole Cookie
        # header is dropped here, which also keeps both cookie names out. AVR-314.
        proxy_set_header Cookie "";
        proxy_read_timeout 3600;
    }

    # Anything else under /games/ names no game (a slug outside the pattern): refused here, never
    # passed to a catch-all. The bare /games is refused the same way.
    location /games/ {
        return 404;
    }
    location = /games {
        return 404;
    }

    # Nothing else is served, and nginx's default document root is never consulted.
    location / {
        return 404;
    }
}
