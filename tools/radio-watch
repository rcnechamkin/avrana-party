#!/usr/bin/env bash
# radio-watch SECONDS [INTERVAL] [OUT.jsonl] — read-only, no sudo. Runs ON the Pi (start it
# detached and read the file once at the end: SSH polling itself disturbs power measurements).
# One JSON line per interval for the party AP (wlan0):
#   stations       associated count (iw), each as a short hash of its MAC (never the MAC),
#                  with inactive ms, tx_failed (cumulative), connected s
#   ping           per party-side neighbour: loss %, avg and mdev (jitter) ms over 5 pings
#   if             wlan0 packet/error/drop deltas since the previous line
#   host           load1, throttled, temp
# For the 4 / 6 / 8 phone capacity targets (docs/runbooks/network.md): start this, add phones one
# at a time, note the times, and look for loss/jitter/tx_failed jumps as the count rises.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
DUR=${1:?usage: radio-watch SECONDS [INTERVAL] [OUT.jsonl]}; INT=${2:-10}
OUT=${3:-$HOME/avrana-lab/radio-watch-$(date +%Y%m%dT%H%M%S).jsonl}
case "$DUR$INT" in *[!0-9]*) echo "SECONDS and INTERVAL must be integers" >&2; exit 2;; esac
[ "$DUR" -le 14400 ] || { echo "capped at 4 h" >&2; exit 2; }
AP=wlan0; S=/sys/class/net/$AP/statistics
mkdir -p "$(dirname "$OUT")"; echo "$OUT"
stat() { cat "$S/$1"; }
prev=""; end=$(( $(date +%s) + DUR ))
while [ "$(date +%s)" -lt "$end" ]; do
  st=$(iw dev $AP station dump 2>/dev/null | awk '
    /^Station/ {if (m) print m, i, f, c; m=$2; i=f=c=""}
    /inactive time/ {i=$3} /tx failed/ {f=$3} /connected time/ {c=$3}
    END {if (m) print m, i, f, c}' | while read -r mac ina fail con; do
      id=$(printf %s "$mac" | sha256sum | cut -c1-8)
      printf '{"id":"%s","inactive_ms":%s,"tx_failed":%s,"connected_s":%s},' "$id" "${ina:-null}" "${fail:-null}" "${con:-null}"
    done)
  pg=$(ip -4 neigh show dev $AP | awk '$0 !~ /FAILED|INCOMPLETE/ {print $1}' | while read -r ip; do
      r=$(ping -n -q -c 5 -i 0.2 -W 1 "$ip" 2>/dev/null)
      loss=$(grep -o '[0-9.]*% packet loss' <<<"$r" | cut -d% -f1)
      read -r avg mdev < <(awk -F'[/ ]' '/rtt/ {print $8, $10}' <<<"$r")
      printf '{"ip":"%s","loss_pct":%s,"avg_ms":%s,"mdev_ms":%s},' "$ip" "${loss:-100}" "${avg:-null}" "${mdev:-null}"
    done)
  now="$(stat tx_packets) $(stat rx_packets) $(stat tx_errors) $(stat rx_errors) $(stat tx_dropped) $(stat rx_dropped)"
  if [ -n "$prev" ]; then
    read -r a b c d e f <<<"$prev"; read -r A B C D E F <<<"$now"
    ifd=$(printf '{"tx_pkts":%d,"rx_pkts":%d,"tx_err":%d,"rx_err":%d,"tx_drop":%d,"rx_drop":%d}' \
      $((A-a)) $((B-b)) $((C-c)) $((D-d)) $((E-e)) $((F-f)))
  else ifd=null; fi
  prev=$now
  n=$(iw dev $AP station dump 2>/dev/null | grep -c '^Station')
  printf '{"ts":"%s","stations_n":%d,"stations":[%s],"ping":[%s],"if":%s,"load1":%s,"throttled":"%s","temp":%s}\n' \
    "$(date +%T)" "$n" "${st%,}" "${pg%,}" "$ifd" "$(cut -d' ' -f1 /proc/loadavg)" \
    "$(vcgencmd get_throttled | cut -d= -f2)" "$(vcgencmd measure_temp | tr -dc 0-9.)" >> "$OUT"
  sleep "$INT"
done
