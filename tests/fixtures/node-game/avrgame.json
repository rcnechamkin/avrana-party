{
  "format": "avrana.avrgame/experimental.1",
  "game": {
    "contract": "avrana.game/v0",
    "id": "hellonode",
    "name": "Hello Node (test fixture)",
    "summary": "Say hello once. A test fixture: the Hello Party rules served by a Node.js process.",
    "kind": "native",
    "players": {
      "min": 1,
      "max": 6
    },
    "screen": "no_tv_needed",
    "input": {
      "model": "browser_native"
    },
    "late_join": "spectator_only",
    "spectators": "watch",
    "private_player_ui": true,
    "runtime": {
      "type": "external",
      "start": "service",
      "permissions": [
        "party_roster"
      ]
    },
    "presentations": [
      {
        "id": "phone_table",
        "method": "browser_native",
        "roles": [
          "player",
          "spectator"
        ],
        "requires": {
          "device": []
        }
      }
    ],
    "fallback": "spectate",
    "accessibility": {
      "timing_pressure": false,
      "audio_required": false
    },
    "extensions": {
      "net.avrana.party": {
        "pregame": false
      },
      "net.avrana.test": {
        "test_only": true
      }
    }
  },
  "package": {
    "version": "0.1.0",
    "publisher": "Avrana Party (test fixture)",
    "license": "MIT"
  },
  "requires": {
    "session": "avrana.party-session/v0",
    "bridge": "avrana.party-bridge/v1",
    "result": "avrana.game-result/v1"
  },
  "server": {
    "interpreter": "node",
    "args": [
      "server/main.mjs"
    ]
  },
  "client": {
    "root": "web"
  }
}
