server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name party.local _;

    location = /hotspot-detect.html {
        # iOS/macOS captive probe: return Apple's literal Success so the phone
        # marks Avrana Party usable and stays connected (no captive popup).
        # Owner chose "no popup, just connect" (2026-09-18); landing page still
        # reachable at http://party.local/. Reverses the earlier "never serve
        # Success" note deliberately. Works offline (served locally, DNS still
        # intercepts captive.apple.com -> 10.42.0.1).
        default_type text/html;
        add_header Cache-Control "no-store" always;
        return 200 "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>\n";
    }

    # Isolated Gauntlet II prototype; LAN Games remains at /.
    location /arcade/ {
        proxy_pass http://127.0.0.1:8097/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8096;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600;
    }
}

# Full Mode uses a publicly trusted certificate for a real hostname. Keep the
# port 80 default server above unchanged for captive probes and legacy clients.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name party.avrana.net;

    ssl_certificate /etc/avrana-party/tls/current/fullchain.pem;
    ssl_certificate_key /etc/avrana-party/tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Avrana Full Mode shell: static, Avrana-owned files under /party/, HTTPS only. The port 80
    # server above is unchanged. Installed by ops/install-party-web.sh (a release directory and
    # an atomic "current" symlink; no reload needed per release). Headers must match
    # avrana/web/devserver.py SHELL_HEADERS (tests/unit/test_nginx_site.py). Never send a
    # Service-Worker-Allowed header: the worker must stay inside /party/.
    location = /party {
        return 301 /party/;
    }

    # Lets a page tell "the Pi answered" from "not on the Party Wi-Fi", and which address and TLS
    # version it reached. Never cached, never answered by the service worker.
    location = /party/api/origin.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"schema":"avrana.origin/v0","scheme":"$scheme","serverAddr":"$server_addr","tls":"$ssl_protocol","http":"$server_protocol"}';
    }

    # Party Core v0 (AVR-51): the party API, avrana-party-core.service on loopback 127.0.0.1:8191
    # (docs/runbooks/party-core-deploy.md). The exact-match origin.json location above keeps
    # answering from nginx. Source copy: deploy/party-core/nginx-party-api.location.
    # Only /party/api/ is forwarded; the service's /internal/ routes are never proxied (and it
    # refuses anything carrying X-Forwarded-For). Long polls wait up to 25 s.
    location /party/api/ {
        proxy_pass http://127.0.0.1:8191;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 40s;
        proxy_buffering off;
        client_max_body_size 8k;
    }

    location /party/ {
        alias /var/www/avrana-party/web/current/;
        index index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    }

    location /arcade/ {
        proxy_pass http://127.0.0.1:8097/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
    }
}
