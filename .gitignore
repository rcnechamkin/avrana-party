# Runtime / generated
arcade/runtime/
__pycache__/
*.pyc
*.log
*.jsonl
*.tmp
*.tmp.*
# Raw measurement evidence stays outside Git; prose summaries and scripts remain tracked.
docs/findings/evidence/**/*.txt
*.lpl
portal-trace.txt

# Emulator cores and game assets (re-fetch per arcade/evidence/selected-core.json)
arcade/cores/
arcade/roms/*
*.zip
*.7z

# Installer backups
backups/

# Bulk research snapshots; keep only small provenance files
arcade/evidence/*
!arcade/evidence/selected-core.json
!arcade/evidence/*-revision.json
!arcade/evidence/gaunt2-mame2010-audit.json
!arcade/evidence/mame2010-gauntlet.c

# Local agent/editor config (no project-shared settings; both files are default)
.claude/

# Safety net
.env*
*.pem
*.key

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
