# Runtime / generated
arcade/runtime/
__pycache__/
*.pyc
*.log
*.jsonl
*.tmp
*.tmp.*
*.lpl
portal-trace.txt

# Emulator cores and game assets (re-fetch per arcade/evidence/selected-core.json)
arcade/cores/
arcade/roms/*
*.zip
*.7z

# Installer backups
backups/

# Bulk research snapshots; keep only small provenance files
arcade/evidence/*
!arcade/evidence/selected-core.json
!arcade/evidence/*-revision.json
!arcade/evidence/gaunt2-mame2010-audit.json
!arcade/evidence/mame2010-gauntlet.c

# Local agent/editor state; only the reviewed project search reminder is shared
.claude/*
!.claude/settings.json
!.claude/agents/
# Only the Avrana design skill is tracked; third-party design skills are installed locally
# by tools/install-design-skills.mjs (docs/agents/design-skills.md)
!.claude/skills/
.claude/skills/*
!.claude/skills/avrana-ux-ui/
.claude/agents/impeccable-*.md
/skills-lock.json
/.agents/

# Safety net
.env*
*.pem
*.key
*.csr
certs/
.lego/
*.db
*.sqlite
*.sqlite3
*.srm
*.state*
*.mcr
*.mcd
*.cue
*.chd
*.pbp
*.iso
*.ecm
*.bin
*.BIN
*.img
docs/findings/evidence/
/brag-output/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
experiments/**/dev-data/
ps1/runtime/

# Playwright
node_modules/
/test-results/
/.linux-verify/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Derived context, private Linear exports, and machine-specific Graphify state
/.graphify-context/
/graphify-out/
/graphify-public/
# Graphify query/export side effects beside the reviewed shared products stay local.
/context/graphify/*
!/context/graphify/semantic-graph.json
!/context/graphify/semantic-receipt.json

# tools/reconcile.py output
reconcile-report.md
reconcile-report.json

# The owner's game covers (box art; AVR-306): shown by the shell, never committed. The empty
# index is the only tracked file; avrana/web/covers.py says what a cover is.
web/party/covers/*
!web/party/covers/index.json

# Local tool scratch at the repository root: a private Python environment (.codex/) and
# scratch copies of the tree (.work-*/). Neither is project content.
/.codex/
/.work-*/

# Editor and operating-system files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python packaging and coverage output
*.egg-info/
.coverage
htmlcov/

# Printed join cards (tools/join-card) carry the Wi-Fi password. The generator refuses to write one
# inside any Git working tree; this is a second line for a card copied in by hand.
*join-card*.html
