server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name party.local _;

    location = /hotspot-detect.html {
        # iOS/macOS captive probe: return Apple's literal Success so the phone
        # marks Avrana Party usable and stays connected (no captive popup).
        # Owner chose "no popup, just connect" (2026-09-18); landing page still
        # reachable at http://party.local/. Reverses the earlier "never serve
        # Success" note deliberately. Works offline (served locally, DNS still
        # intercepts captive.apple.com -> 10.42.0.1).
        default_type text/html;
        add_header Cache-Control "no-store" always;
        return 200 "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>\n";
    }

    # Isolated Gauntlet II prototype; LAN Games remains at /.
    location /arcade/ {
        proxy_pass http://127.0.0.1:8097/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8096;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600;
    }
}
